# Copy to .env and fill in. .env is gitignored.
# All four come from iot.tuya.com plus the Smart Life app - see README step 3.

# Project -> Overview -> Authorization Key -> Access ID
TUYA_API_KEY=

# Project -> Overview -> Authorization Key -> Access Secret
TUYA_API_SECRET=

# Must match the data centre serving your app account's country, which is set
# at registration. Check in the app: Me -> Settings -> Account and Security -> Region.
# A mismatch returns an EMPTY device list rather than an error.
#   cn   China              us    Western America     us-e  Eastern America
#   eu   Central Europe     eu-w  Western Europe      in    India
#   sg   Singapore
# Australia and New Zealand are served by Central Europe (eu).
TUYA_API_REGION=

# Smart Life app -> any device -> pencil icon -> Device Information -> Virtual ID
TUYA_API_DEVICE_ID=
